Set-Content -Path .gitignore -Encoding ascii -Value @'
# ScoutData .gitignore - version canonica (ASCII, reescrito por terminal)
# Python / venv
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
# caches de tests/build
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ipynb_checkpoints/
# datos crudos: se descargan, NO se versionan
data/raw/
# cache de RUNTIME de fetch_live (artefacto, no source of truth)
# OJO: data/external/fifa_ranking_2026.json SI entra (source of truth)
data/external/live_cache/
# IDE / SO
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
# secrets: la API key NUNCA se commitea
.env
.env.*
*.key
secrets/
credentials.json
# logs
*.log
logs/
# node (tooling futuro; el repo Expo es HERMANO, no hijo)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
'@